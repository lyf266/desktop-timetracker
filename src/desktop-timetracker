        cat_key = CATEGORY_NAME_TO_KEY.get(cat_raw.lower())

    if cat_key and cat_key in CANONICAL_CATEGORIES:
        item = CANONICAL_CATEGORIES[cat_key]
        return item[lang], item["icon"]
    return cat_raw, "📌"


def format_duration(seconds, lang="en"):
    if seconds < 0:
        seconds = 0
    h = seconds // 3600
    m = (seconds % 3600) // 60
    s = seconds % 60
    t = I18N[lang]
    if h > 0:
        return t["dur_h_m"].format(h=h, m=m)
    elif m > 0:
        return t["dur_m_s"].format(m=m, s=s)
    else:
        return t["dur_s"].format(s=s)


def format_duration_short(seconds):
    h = seconds // 3600
    m = (seconds % 3600) // 60
    if h > 0:
        return f"{h}h {m:02d}m"
    elif m > 0:
        return f"{m}m"
    else:
        return f"{seconds}s"


def make_bar(ratio, width=16):
    full_blocks = int(ratio * width)
    remainder = (ratio * width) - full_blocks
    chars = ["", "▏", "▎", "▍", "▌", "▋", "▊", "▉"]
    sub_char = chars[int(remainder * 8)] if remainder > 0 else ""
    bar = "█" * full_blocks + sub_char
    return bar.ljust(width, "░")


class XDGDesktopIndex:
    """Fast in-memory index for XDG .desktop files across the system."""

    def __init__(self):
        self.index = {}
        self.dirs = [
            "/usr/share/applications",
            "/usr/local/share/applications",
            os.path.expanduser("~/.local/share/applications"),
            "/var/lib/flatpak/exports/share/applications",
            os.path.expanduser("~/.local/share/flatpak/exports/share/applications"),
        ]
        self.scan()

    def scan(self):
        self.index.clear()
        for d in self.dirs:
            if not os.path.isdir(d):
                continue
            for path in glob.glob(os.path.join(d, "*.desktop")):
                stem = os.path.splitext(os.path.basename(path))[0].lower()
                entry = {"name": "", "name_zh": "", "categories": [], "wm_class": "", "icon": ""}
                try:
                    with open(path, "r", encoding="utf-8", errors="ignore") as f:
                        in_section = False
                        for line in f:
                            line = line.strip()
                            if line == "[Desktop Entry]":
                                in_section = True
                                continue
                            elif line.startswith("[") and in_section:
                                break
                            if not in_section or "=" not in line:
                                continue
                            k, v = line.split("=", 1)
                            k, v = k.strip(), v.strip()
                            if k == "Name":
                                entry["name"] = v
                            elif k in ["Name[zh_CN]", "Name[zh]"] and not entry["name_zh"]:
                                entry["name_zh"] = v
                            elif k == "Categories":
                                entry["categories"] = [c.strip() for c in v.split(";") if c.strip()]
                            elif k == "StartupWMClass":
                                entry["wm_class"] = v.lower()
                            elif k == "Icon":
                                entry["icon"] = v
                except Exception:
                    continue

                if entry["name"]:
                    self.index[stem] = entry
                    if entry["wm_class"]:
                        self.index[entry["wm_class"]] = entry

    def lookup(self, *keys):
        for k in keys:
            if not k:
                continue
            k_clean = str(k).lower().strip()
            if k_clean.endswith(".desktop"):
                k_clean = k_clean[:-8]

            if k_clean in self.index:
                return self.index[k_clean]

            # Try prefix stripping (e.g. org.kde.dolphin -> dolphin, com.obsproject.Studio -> studio)
            if "." in k_clean:
                sub = k_clean.split(".")[-1]
                if sub in self.index:
                    return self.index[sub]
        return None


class InputActivityMonitor:
    """Zero-dependency, privacy-first background hardware input monitor.

    Strict Invariants:
    1. Blind key counter: When ev_type == EV_KEY and val == 1 on a keyboard,
       immediately increment key_presses += 1. The keycode is NEVER stored,
       logged, or mapped in memory.
    2. Motion scalar: Mouse dx/dy are accumulated as Euclidean distance scalars only.
       Screen coordinates (x, y) are never tracked.
    3. 100% local, thread-safe, gracefully handles missing /dev/input permissions.
    """

    def __init__(self):
        self.lock = threading.Lock()
        self._key_presses = 0
        self._mouse_clicks = 0
        self._mouse_distance_px = 0.0

        # Mouse relative delta buffer per-device fd
        self._mouse_dx = {}
        self._mouse_dy = {}

        self.running = False
        self.thread = None
        self.has_permission = True
        self._warned_permission = False
        self._fds = {}  # fd: (dev_type, node)
        self._selector = None

    def start(self):
        if self.running:
            return
        self.running = True
        self.thread = threading.Thread(target=self._worker, name="InputActivityMonitor", daemon=True)
        self.thread.start()

    def stop(self):
        self.running = False
        if self._selector:
            try:
                self._selector.close()
            except Exception:
                pass
        for fd in list(self._fds.keys()):
            try:
                os.close(fd)
            except Exception:
                pass
        self._fds.clear()

    def get_and_reset(self):
        with self.lock:
            for fd in list(self._mouse_dx.keys()):
                dx = self._mouse_dx.get(fd, 0)
                dy = self._mouse_dy.get(fd, 0)
                if dx != 0 or dy != 0:
                    self._mouse_distance_px += math.hypot(dx, dy)
                    self._mouse_dx[fd] = 0
                    self._mouse_dy[fd] = 0

            keys = self._key_presses
            clicks = self._mouse_clicks
            dist = int(round(self._mouse_distance_px))
            self._key_presses = 0
            self._mouse_clicks = 0
            self._mouse_distance_px = 0.0
            return keys, clicks, dist

    @staticmethod
    def scan_devices():
        keyboards = []
        mice = []
        devices_file = Path("/proc/bus/input/devices")
        if not devices_file.exists():
            return keyboards, mice

        try:
            with open(devices_file, "r", encoding="utf-8", errors="ignore") as f:
                content = f.read()
        except Exception:
            return keyboards, mice

        blocks = content.strip().split("\n\n")
        for b in blocks:
            lines = b.splitlines()
            name = ""
            handlers = []
            for line in lines:
                if line.startswith("N: Name="):
                    name = line.split("=", 1)[1].strip('"')
                elif line.startswith("H: Handlers="):
                    handlers = line.split("=", 1)[1].strip().split()

            event_node = None
            for h in handlers:
                if h.startswith("event"):
                    event_node = f"/dev/input/{h}"
                    break
            if not event_node:
                continue

            lower_name = name.lower()
            if any(ign in lower_name for ign in ["power button", "sleep button", "lid switch", "video bus", "speaker"]):
                continue

            is_mouse = "mouse" in handlers or any("mouse" in h for h in handlers) or "touchpad" in lower_name
            is_kbd = "kbd" in handlers and not is_mouse

            if is_kbd:
                keyboards.append((name, event_node))
            elif is_mouse:
                mice.append((name, event_node))

        return keyboards, mice

    def _init_devices(self):
        if not self._selector:
            self._selector = selectors.DefaultSelector()

        keyboards, mice = self.scan_devices()
        all_devs = [(name, node, "kbd") for name, node in keyboards] + [(name, node, "mouse") for name, node in mice]

        permission_err = False
        opened_any = False
        current_nodes = {dev_info[1] for dev_info in self._fds.values()}

        for name, node, dev_type in all_devs:
            if node in current_nodes:
                continue
            try:
                fd = os.open(node, os.O_RDONLY | os.O_NONBLOCK)
                self._selector.register(fd, selectors.EVENT_READ)
                self._fds[fd] = (dev_type, node)
                self._mouse_dx[fd] = 0
                self._mouse_dy[fd] = 0
                opened_any = True
            except PermissionError:
                permission_err = True
            except Exception:
                pass

        if permission_err and not opened_any:
            self.has_permission = False
            if not self._warned_permission:
                self._warned_permission = True
                print(f"[{datetime.datetime.now()}] ⚠️ [Notice] /dev/input read access needed for keyboard/mouse activity metrics.")
                print(f"[{datetime.datetime.now()}] To enable: sudo usermod -aG input $USER (then re-login). Continuing tracking window duration.")
        elif opened_any:
            self.has_permission = True
            if self._warned_permission:
                print(f"[{datetime.datetime.now()}] ✅ /dev/input opened successfully. Keyboard & mouse activity tracking is active.")
                self._warned_permission = False

    def _worker(self):
        last_scan_time = 0
        while self.running:
            now = time.time()
            if now - last_scan_time > 30:
                last_scan_time = now
                self._init_devices()

            if not self._fds:
                time.sleep(2.0)
                continue

            try:
                events = self._selector.select(timeout=1.0)
            except Exception:
                break

            for key, mask in events:
                fd = key.fd
                dev_type, node = self._fds.get(fd, ("unknown", ""))
                try:
                    data = os.read(fd, EVENT_SIZE * 64)
                except (BlockingIOError, InterruptedError):
                    continue
                except Exception:
                    try:
                        self._selector.unregister(fd)
                        os.close(fd)
                    except Exception:
                        pass
                    self._fds.pop(fd, None)
                    continue

                if not data:
                    continue

                num_events = len(data) // EVENT_SIZE
                for i in range(num_events):
                    chunk = data[i * EVENT_SIZE:(i + 1) * EVENT_SIZE]
                    sec, usec, ev_type, code, val = struct.unpack(EVENT_FORMAT, chunk)

                    if dev_type == "kbd":
                        # Absolute blind counter: count press (val == 1), immediately discard keycode
                        if ev_type == 1 and val == 1:
                            with self.lock:
                                self._key_presses += 1
                    elif dev_type == "mouse":
                        if ev_type == 2:  # EV_REL
                            if code == 0:  # REL_X
                                self._mouse_dx[fd] = self._mouse_dx.get(fd, 0) + val
                            elif code == 1:  # REL_Y
                                self._mouse_dy[fd] = self._mouse_dy.get(fd, 0) + val
                        elif ev_type == 0:  # EV_SYN
                            dx = self._mouse_dx.get(fd, 0)
                            dy = self._mouse_dy.get(fd, 0)
                            if dx != 0 or dy != 0:
                                dist = math.hypot(dx, dy)
                                with self.lock:
                                    self._mouse_distance_px += dist
                                self._mouse_dx[fd] = 0
                                self._mouse_dy[fd] = 0
                        elif ev_type == 1 and val == 1:  # EV_KEY (button press)
                            with self.lock:
                                self._mouse_clicks += 1


class Database:
    def __init__(self, db_path=DB_FILE):
        self.db_path = db_path
        self._init_db()

    def get_conn(self):
        conn = sqlite3.connect(self.db_path)
        conn.row_factory = sqlite3.Row
        conn.execute("PRAGMA journal_mode=WAL;")
        conn.execute("PRAGMA synchronous=NORMAL;")
        return conn

    def _init_db(self):
        ensure_dirs()
        conn = self.get_conn()
        try:
            with conn:
                conn.execute("""
                    CREATE TABLE IF NOT EXISTS window_activities (
                        id INTEGER PRIMARY KEY AUTOINCREMENT,
                        start_time TEXT NOT NULL,
                        end_time TEXT NOT NULL,
                        duration_seconds INTEGER NOT NULL,
                        app_id TEXT NOT NULL,
                        app_name TEXT NOT NULL,
                        window_title TEXT NOT NULL,
                        category TEXT NOT NULL,
                        is_locked INTEGER DEFAULT 0,
                        is_idle INTEGER DEFAULT 0,
                        key_presses INTEGER DEFAULT 0,
                        mouse_clicks INTEGER DEFAULT 0,
                        mouse_distance_px INTEGER DEFAULT 0
                    );
                """)
                conn.execute("CREATE INDEX IF NOT EXISTS idx_activity_time ON window_activities(start_time, end_time);")
                conn.execute("CREATE INDEX IF NOT EXISTS idx_activity_category ON window_activities(category);")
                conn.execute("CREATE INDEX IF NOT EXISTS idx_activity_app ON window_activities(app_id);")

                # Backward-compatibility schema migration
                cur = conn.execute("PRAGMA table_info(window_activities);")
                cols = [r["name"] for r in cur.fetchall()]
                if "key_presses" not in cols:
                    conn.execute("ALTER TABLE window_activities ADD COLUMN key_presses INTEGER DEFAULT 0;")
                if "mouse_clicks" not in cols:
                    conn.execute("ALTER TABLE window_activities ADD COLUMN mouse_clicks INTEGER DEFAULT 0;")
                if "mouse_distance_px" not in cols:
                    conn.execute("ALTER TABLE window_activities ADD COLUMN mouse_distance_px INTEGER DEFAULT 0;")
        finally:
            conn.close()

    def save_record(self, start_time, end_time, duration, app_id, app_name, window_title, category, is_locked, is_idle, key_presses=0, mouse_clicks=0, mouse_distance_px=0, record_id=None):
        if duration <= 0:
            return None
        conn = self.get_conn()
        try:
            with conn:
                if record_id:
                    conn.execute("""
                        UPDATE window_activities
                        SET end_time = ?, duration_seconds = ?, is_idle = ?,
                            key_presses = ?, mouse_clicks = ?, mouse_distance_px = ?
                        WHERE id = ?
                    """, (end_time, duration, is_idle, key_presses, mouse_clicks, mouse_distance_px, record_id))
                    return record_id
                else:
                    cur = conn.execute("""
                        INSERT INTO window_activities (
                            start_time, end_time, duration_seconds,
                            app_id, app_name, window_title, category,
                            is_locked, is_idle,
                            key_presses, mouse_clicks, mouse_distance_px
                        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                    """, (start_time, end_time, duration, app_id, app_name, window_title, category, is_locked, is_idle, key_presses, mouse_clicks, mouse_distance_px))
                    return cur.lastrowid
        finally:
            conn.close()

    def query_day(self, target_date):
        try:
            dt = datetime.date.fromisoformat(str(target_date).strip())
        except Exception:
            dt = datetime.date.today()
        target_str = dt.isoformat()
        next_str = (dt + datetime.timedelta(days=1)).isoformat()

        conn = self.get_conn()
        try:
            cur = conn.execute("""
                SELECT * FROM window_activities
                WHERE start_time >= ? AND start_time < ?
                ORDER BY start_time ASC
            """, (f"{target_str} 00:00:00", f"{next_str} 00:00:00"))
            return [dict(r) for r in cur.fetchall()]
        finally:
            conn.close()

    def query_date_range(self, start_date, end_date):
        try:
            s_dt = datetime.date.fromisoformat(str(start_date).strip())
        except Exception:
            s_dt = datetime.date.today() - datetime.timedelta(days=6)
        try:
            e_dt = datetime.date.fromisoformat(str(end_date).strip())
        except Exception:
            e_dt = datetime.date.today()
        start_str = s_dt.isoformat()
        next_end_str = (e_dt + datetime.timedelta(days=1)).isoformat()

        conn = self.get_conn()
        try:
            cur = conn.execute("""
                SELECT * FROM window_activities
                WHERE start_time >= ? AND start_time < ?
                ORDER BY start_time ASC
            """, (f"{start_str} 00:00:00", f"{next_end_str} 00:00:00"))
            return [dict(r) for r in cur.fetchall()]
        finally:
            conn.close()


class Classifier:
    """Three-Tier Progressive Classification Pipeline:
    Tier 1: rules.json (User Custom Overrides)
    Tier 2: System XDG .desktop Metadata (Weighted Specificity Categories & Localized Names)
    Tier 3: Fallback (other)
    """

    def __init__(self, rules):
        self.rules = rules
        self.xdg_index = XDGDesktopIndex()

    def classify(self, app_id, window_title, is_locked, desktop_file="", resource_class="", resource_name="", lang="en"):
        if is_locked:
            return "locked", "🔒", I18N[lang]["screen_locked"]

        app_id_clean = (app_id or "").lower().strip()
        title_clean = window_title or ""

        # Step A: Resolve official application name via XDG Index
        xdg_entry = self.xdg_index.lookup(desktop_file, resource_class, resource_name, app_id_clean)

        friendly_name = None
        if xdg_entry:
            if lang == "zh" and xdg_entry.get("name_zh"):
                friendly_name = xdg_entry["name_zh"]
            else:
                friendly_name = xdg_entry.get("name")

        if not friendly_name:
            friendly_name = APP_NAME_MAP.get(app_id_clean)
        if not friendly_name:
            if app_id_clean:
                friendly_name = app_id_clean.split(".")[-1].replace("-", " ").replace("_", " ").title()
            else:
                friendly_name = I18N[lang]["unknown_app"]

        # =========================================================================
        # TIER 1: rules.json (User Custom Overrides - Highest Priority)
        # =========================================================================
        for cat in self.rules.get("categories", []):
            cat_id = cat.get("id") or CATEGORY_NAME_TO_KEY.get(cat.get("name", ""), "other")
            icon = cat.get("icon", "📌")

            # Check app ID matching
            for a in cat.get("apps", []):
                a_lower = a.lower()
                if a_lower and (
                    a_lower in app_id_clean or
                    (resource_class and a_lower in resource_class.lower()) or
                    (desktop_file and a_lower in desktop_file.lower())
                ):
                    return cat_id, icon, friendly_name

            # Check window title keywords
            for kw in cat.get("title_keywords", []):
                if kw and kw.lower() in title_clean.lower():
                    return cat_id, icon, friendly_name

        # =========================================================================
        # TIER 2: System XDG .desktop Metadata (Weighted Specificity Categories)
        # =========================================================================
        if xdg_entry and xdg_entry.get("categories"):
            cats = xdg_entry["categories"]
            for xdg_kw, target_cat in XDG_CATEGORY_PRIORITY:
                if xdg_kw in cats:
                    canonical_info = CANONICAL_CATEGORIES.get(target_cat, {})
                    icon = canonical_info.get("icon", "📌")
                    return target_cat, icon, friendly_name

        # =========================================================================
        # TIER 3: Fallback Default
        # =========================================================================
        default_cat = self.rules.get("default_category", "other")
        canonical_info = CANONICAL_CATEGORIES.get(default_cat, {})
        icon = canonical_info.get("icon", "📌")
        return default_cat, icon, friendly_name


class ReportGenerator:
    @staticmethod
    def generate_markdown(records, target_date, lang="en"):
        t = I18N[lang]
        if not records:
            return f"{t['md_title'].format(date=target_date)}\n\n{t['md_no_records']}\n"

        total_active_secs = 0
        total_locked_secs = 0
        total_keys = 0
        total_clicks = 0
        total_mouse_px = 0
        cat_times = {}
        app_times = {}
        window_times = {}
        hourly_active = {h: 0 for h in range(24)}
        hourly_keys = {h: 0 for h in range(24)}
        hourly_mouse = {h: 0 for h in range(24)}

        for r in records:
            dur = r["duration_seconds"]
            is_locked = r["is_locked"]
            cat_raw = r["category"]
            app = r["app_name"]
            title = r["window_title"].strip() or "Untitled"

            if is_locked:
                total_locked_secs += dur
            else:
                total_active_secs += dur
                kp = r.get("key_presses") or 0
                mc = r.get("mouse_clicks") or 0
                mdist = r.get("mouse_distance_px") or 0
                total_keys += kp
                total_clicks += mc
                total_mouse_px += mdist

                cat_display, _ = get_category_display(cat_raw, lang)
                cat_times[cat_display] = cat_times.get(cat_display, 0) + dur
                app_times[app] = app_times.get(app, 0) + dur
                window_times[(app, title)] = window_times.get((app, title), 0) + dur

                try:
                    start_dt = datetime.datetime.fromisoformat(r["start_time"])
                    h = start_dt.hour
                    hourly_active[h] += dur
                    hourly_keys[h] += kp
                    hourly_mouse[h] += mdist
                except Exception:
                    pass

        grand_total = total_active_secs + total_locked_secs
        active_mins = total_active_secs / 60.0
        kpm = (total_keys / active_mins) if active_mins > 0 else 0.0

        sorted_cats = sorted(cat_times.items(), key=lambda x: x[1], reverse=True)
        sorted_apps = sorted(app_times.items(), key=lambda x: x[1], reverse=True)[:10]
        sorted_windows = sorted(window_times.items(), key=lambda x: x[1], reverse=True)[:10]

        md = []
        md.append(t["md_title"].format(date=target_date))
        md.append(f"\n> {t['md_generated_at'].format(dt=datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S'))}\n")

        # Core KPIs
        md.append(f"{t['md_core_kpis']}\n")
        pct_active = (total_active_secs / grand_total * 100) if grand_total else 0
        pct_locked = (total_locked_secs / grand_total * 100) if grand_total else 0
        md.append(f"- **{t['md_total_uptime']}**: `{format_duration(grand_total, lang)}`")
        md.append(f"- **{t['md_active_focus']}**: `{format_duration(total_active_secs, lang)}` ({pct_active:.1f}%)")
        md.append(f"- **{t['md_locked_away']}**: `{format_duration(total_locked_secs, lang)}` ({pct_locked:.1f}%)")
        md.append(f"- **{t['md_total_keys']}**: `{total_keys:,} {t['unit_short']}` ({kpm:.1f} {t['kpm_unit']})")
        md.append(f"- **{t['md_total_mouse']}**: `{format_distance(total_mouse_px, lang)}` ({t['mouse_clicks_label']}: {total_clicks:,})")

        # Category Table
        md.append(f"\n{t['md_cat_table_title']}\n")
        md.append(f"| {t['md_col_cat']} | {t['md_col_dur']} | {t['md_col_share']} | {t['md_col_bar']} |")
        md.append("| :--- | :--- | :--- | :--- |")
        for cat, secs in sorted_cats:
            ratio = (secs / total_active_secs) if total_active_secs > 0 else 0
            bar = make_bar(ratio, width=15)
            md.append(f"| **{cat}** | `{format_duration(secs, lang)}` | `{ratio*100:.1f}%` | `{bar}` |")

        # Top Apps Table
        md.append(f"\n{t['md_top_apps_title']}\n")
        md.append(f"| {t['md_col_rank']} | {t['md_col_app']} | {t['md_col_dur']} | {t['md_col_share_active']} |")
        md.append("| :---: | :--- | :--- | :--- |")
        for idx, (app, secs) in enumerate(sorted_apps, 1):
            ratio = (secs / total_active_secs) if total_active_secs > 0 else 0
            md.append(f"| {idx} | **{app}** | `{format_duration(secs, lang)}` | `{ratio*100:.1f}%` |")

        # Top Tasks Table
        md.append(f"\n{t['md_key_tasks_title']}\n")
        md.append(f"| {t['md_col_rank']} | {t['md_col_app']} | {t['md_col_details']} | {t['md_col_dur']} |")
        md.append("| :---: | :--- | :--- | :--- |")
        for idx, ((app, title), secs) in enumerate(sorted_windows, 1):
            clean_title = title.replace("|", "-")
            if len(clean_title) > 60:
                clean_title = clean_title[:57] + "..."
            md.append(f"| {idx} | {app} | `{clean_title}` | `{format_duration(secs, lang)}` |")

        # Hourly Activity Chart
        md.append(f"\n{t['md_hourly_title']}\n")
        md.append(f"| {t['md_col_period']} | {t['col_focus']} | {t['md_col_keys']} | {t['md_col_mouse']} | {t['md_col_viz']} |")
        md.append("| :---: | :--- | :--- | :--- | :--- |")
        for h in range(24):
            secs = hourly_active[h]
            keys = hourly_keys[h]
            m_px = hourly_mouse[h]
            if secs > 0 or keys > 0 or m_px > 0:
                ratio = min(secs / 3600.0, 1.0)
                bar = make_bar(ratio, width=12)
                keys_str = f"{keys:,} {t['unit_short']}"
                dist_str = format_distance(m_px, lang)
                md.append(f"| `{h:02d}:00 - {h+1:02d}:00` | `{format_duration_short(secs)}` | `{keys_str}` | `{dist_str}` | `{bar}` |")

        md.append(f"\n---\n{t['md_footer']}\n")
        return "\n".join(md)


class Daemon:
    def __init__(self):
        self.rules = load_rules()
        self.classifier = Classifier(self.rules)
        self.db = Database()
        self.running = True
        self.current_chunk = None
        self.last_flush_time = time.time()
        self.kwin_script_id = None
        self.journal_proc = None
        self.input_monitor = InputActivityMonitor()
        self.input_monitor.start()
        self._pending_carryover_mouse_px = 0.0

    def checkpoint_db(self):
        try:
            conn = self.db.get_conn()
            try:
                conn.execute("PRAGMA wal_checkpoint(TRUNCATE);")
                conn.execute("PRAGMA optimize;")
            finally:
                conn.close()
            print(f"[{datetime.datetime.now()}] Database WAL checkpointed (TRUNCATE) and optimized.")
        except Exception as e:
            print(f"[{datetime.datetime.now()}] Warning: failed to checkpoint WAL: {e}")

    def get_lock_status(self):
        try:
            res = subprocess.run(
                ["qdbus6", "org.freedesktop.ScreenSaver", "/ScreenSaver", "org.freedesktop.ScreenSaver.GetActive"],
                capture_output=True, text=True, timeout=1.5
            )
            return res.stdout.strip() == "true"
        except Exception:
            return False

    def load_kwin_script(self):
        subprocess.run(["qdbus6", "org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting.unloadScript", "timetracker_kwin"], capture_output=True)
        res = subprocess.run(
            ["qdbus6", "org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting.loadScript", str(KWIN_SCRIPT_FILE), "timetracker_kwin"],
            capture_output=True, text=True
        )
        script_id = res.stdout.strip()
        if script_id and script_id.isdigit() and int(script_id) >= 0:
            self.kwin_script_id = int(script_id)
            subprocess.run(["qdbus6", "org.kde.KWin", f"/Scripting/Script{self.kwin_script_id}", "org.kde.kwin.Script.run"], capture_output=True)
            print(f"[{datetime.datetime.now()}] KWin script registered successfully (id={self.kwin_script_id})")
            return True
        else:
            print(f"[{datetime.datetime.now()}] Warning: failed to load KWin script: {res.stderr or res.stdout}")
            return False

    def unload_kwin_script(self):
        try:
            subprocess.run(["qdbus6", "org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting.unloadScript", "timetracker_kwin"], capture_output=True)
        except Exception:
            pass

    def flush_chunk(self, final=False):
        if not self.current_chunk:
            return

        c = self.current_chunk
        now = datetime.datetime.now()
        start_dt = c["start_dt"]
        last_dt = c["last_dt"]
        duration = max(1, int((last_dt - start_dt).total_seconds()))

        # Anti-churn debounce for transient switches:
        # If final=True (switching away), chunk has not been written to DB (db_id is None),
        # duration < 2 seconds, no key/mouse inputs occurred, and not screen-locked:
        # Discard as transient focus jitter (Alt-Tab pass-through, tooltip/popup flickers).
        is_transient = (
            final
            and c.get("db_id") is None
            and duration < 2
            and not c.get("is_locked", 0)
            and c.get("key_presses", 0) == 0
            and c.get("mouse_clicks", 0) == 0
        )

        if is_transient:
            self._pending_carryover_mouse_px += c.get("mouse_distance_px", 0.0)
            self.current_chunk = None
            return

        soft_threshold = self.rules.get("soft_idle_threshold_seconds", 900)
        is_idle = 1 if (duration > soft_threshold and not c["is_locked"]) else 0

        rec_id = self.db.save_record(
            start_time=start_dt.strftime("%Y-%m-%d %H:%M:%S"),
            end_time=last_dt.strftime("%Y-%m-%d %H:%M:%S"),
            duration=duration,
            app_id=c["app_id"],
            app_name=c["app_name"],
            window_title=c["window_title"],
            category=c["category"],
            is_locked=c["is_locked"],
            is_idle=is_idle,
            key_presses=c.get("key_presses", 0),
            mouse_clicks=c.get("mouse_clicks", 0),
            mouse_distance_px=c.get("mouse_distance_px", 0),
            record_id=c.get("db_id")
        )
        c["db_id"] = rec_id
        self.last_flush_time = time.time()

        if final:
            self.current_chunk = None

    def check_daily_rollover(self, current_date_str):
        if self.current_chunk:
            chunk_date = self.current_chunk["start_dt"].strftime("%Y-%m-%d")
            if chunk_date != current_date_str:
                print(f"[{datetime.datetime.now()}] Date rollover detected ({chunk_date} -> {current_date_str}). Exporting report.")
                self.flush_chunk(final=True)
                self.export_report(chunk_date)
                self.checkpoint_db()

    def check_hourly_rollover(self, now):
        if self.current_chunk:
            chunk_dt = self.current_chunk["start_dt"]
            if chunk_dt.hour != now.hour or chunk_dt.date() != now.date():
                self.flush_chunk(final=True)

    def export_report(self, date_str):
        try:
            records = self.db.query_day(date_str)
            if records:
                lang = get_language()
                content = ReportGenerator.generate_markdown(records, date_str, lang=lang)
                out_file = REPORTS_DIR / f"{date_str}.md"
                with open(out_file, "w", encoding="utf-8") as f:
                    f.write(content)
                print(f"[{datetime.datetime.now()}] Daily report exported to {out_file}")
        except Exception as e:
            print(f"[{datetime.datetime.now()}] Error exporting report for {date_str}: {e}")

    def handle_sample(self, window_data):
        now = datetime.datetime.now()
        today_str = now.strftime("%Y-%m-%d")
        self.check_daily_rollover(today_str)
        self.check_hourly_rollover(now)

        delta_keys, delta_clicks, delta_dist = self.input_monitor.get_and_reset()
        if self.current_chunk:
            self.current_chunk["key_presses"] = self.current_chunk.get("key_presses", 0) + delta_keys
            self.current_chunk["mouse_clicks"] = self.current_chunk.get("mouse_clicks", 0) + delta_clicks
            self.current_chunk["mouse_distance_px"] = self.current_chunk.get("mouse_distance_px", 0) + delta_dist
            pending_keys = 0
            pending_clicks = 0
            pending_dist = 0
        else:
            pending_keys = delta_keys
            pending_clicks = delta_clicks
            pending_dist = delta_dist

        is_locked = self.get_lock_status()
        lang = get_language()
        t = I18N[lang]

        if is_locked:
            app_id = "screensaver"
            window_title = t["screen_locked"]
            desktop_file = ""
            resource_class = ""
            resource_name = ""
        elif not window_data:
            app_id = "plasmashell"
            window_title = t["desktop_empty"]
            desktop_file = "plasmashell"
            resource_class = "plasmashell"
            resource_name = "plasmashell"
        else:
            desktop_file = window_data.get("desktopFile") or ""
            resource_class = window_data.get("resourceClass") or ""
            resource_name = window_data.get("resourceName") or ""
            app_id = desktop_file or resource_class or resource_name or "unknown"
            window_title = window_data.get("caption") or ""

        category_key, icon, app_name = self.classifier.classify(
            app_id=app_id,
            window_title=window_title,
            is_locked=is_locked,
            desktop_file=desktop_file,
            resource_class=resource_class,
            resource_name=resource_name,
            lang=lang
        )

        if self.current_chunk:
            c = self.current_chunk
            same_app = (c["app_id"] == app_id)
            same_title = (c["window_title"] == window_title)
            same_lock = (c["is_locked"] == (1 if is_locked else 0))

            if same_app and same_title and same_lock:
                c["last_dt"] = now
                if time.time() - self.last_flush_time >= 10:
                    self.flush_chunk(final=False)
                return

        self.flush_chunk(final=True)

        self.current_chunk = {
            "start_dt": now,
            "last_dt": now,
            "app_id": app_id,
            "app_name": app_name,
            "window_title": window_title,
            "category": category_key,
            "is_locked": 1 if is_locked else 0,
            "db_id": None,
            "key_presses": pending_keys,
            "mouse_clicks": pending_clicks,
            "mouse_distance_px": pending_dist + self._pending_carryover_mouse_px
        }
        self._pending_carryover_mouse_px = 0.0

    def run(self):
        print(f"[{datetime.datetime.now()}] Starting Desktop TimeTracker Daemon...")
        ensure_dirs()
        self.load_kwin_script()

        def sig_handler(sig, frame):
            print(f"\n[{datetime.datetime.now()}] Received shutdown signal ({sig}). Cleaning up...")
            self.running = False

        signal.signal(signal.SIGINT, sig_handler)
        signal.signal(signal.SIGTERM, sig_handler)

        cmd = ["journalctl", "--user", "-u", "plasma-kwin_wayland", "-f", "-o", "cat", "--lines", "0"]
        self.journal_proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, bufsize=1)

        last_heartbeat = time.time()

        try:
            while self.running:
                line = self.journal_proc.stdout.readline()
                if not line:
                    time.sleep(0.5)
                    continue

                if "TIMETRACKER_TICK:" in line:
                    raw_data = line.split("TIMETRACKER_TICK:", 1)[1].strip()
                    try:
                        data = None if raw_data == "null" else json.loads(raw_data)
                        self.handle_sample(data)
                    except Exception:
                        pass

                if time.time() - last_heartbeat > 60:
                    last_heartbeat = time.time()
                    today_str = datetime.datetime.now().strftime("%Y-%m-%d")
                    self.export_report(today_str)

        finally:
            print(f"[{datetime.datetime.now()}] Finalizing database and unloading script...")
            self.input_monitor.stop()
            self.flush_chunk(final=True)
            self.checkpoint_db()
            if self.journal_proc:
                self.journal_proc.terminate()
            self.unload_kwin_script()
            print(f"[{datetime.datetime.now()}] TimeTracker Daemon stopped cleanly.")


