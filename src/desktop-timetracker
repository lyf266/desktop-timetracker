def cmd_lang(args):
    rules = load_rules()
    current_cfg = rules.get("language", "auto")
    effective_lang = get_language()

    if not args.target:
        print(f"\nCurrent language setting: \033[1;36m{current_cfg}\033[0m (Effective: \033[1;32m{effective_lang}\033[0m)")
        print("Available languages: en (English), zh (Simplified Chinese), auto (Follow system locale)")
        print("Usage:")
        print("  timetrack lang en    - Set language to English")
        print("  timetrack lang zh    - Set language to Simplified Chinese")
        print("  timetrack lang auto  - Auto-detect from system locale\n")
        return

    target = args.target.lower()
    if target not in ["en", "zh", "auto"]:
        print(f"Error: Unsupported language '{target}'. Choose from 'en', 'zh', or 'auto'.")
        sys.exit(1)

    rules["language"] = target
    save_rules(rules)
    new_effective = get_language()
    t = I18N[new_effective]
    print(f"✅ {t['lang_switched'].format(lang=f'{target} ({new_effective})')}")


def cmd_service(args):
    action = args.action
    if action == "install":
        SYSTEMD_USER_DIR.mkdir(parents=True, exist_ok=True)
        service_content = f"""[Unit]
Description=KDE Wayland Desktop Time Tracker Daemon
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/desktop-timetracker daemon
Restart=always
RestartSec=5s
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target
"""
        with open(SERVICE_FILE, "w", encoding="utf-8") as f:
            f.write(service_content)
        subprocess.run(["systemctl", "--user", "daemon-reload"])
        subprocess.run(["systemctl", "--user", "enable", "--now", "desktop-timetracker.service"])
        t = I18N[get_language()]
        print(f"✅ {t['service_installed']}")
    elif action in ["start", "stop", "restart", "status", "enable", "disable"]:
        subprocess.run(["systemctl", "--user", action, "desktop-timetracker.service"])


def main():
    parser = argparse.ArgumentParser(
        prog="desktop-timetracker",
        description="KDE Plasma 6 Wayland Desktop Time Tracking & Analytics"
    )
    subparsers = parser.add_subparsers(dest="subcommand", help="Subcommand")

    # daemon
    subparsers.add_parser("daemon", help="Start the background tracking daemon")

    # today
    parser_today = subparsers.add_parser("today", help="Show today's screen time report")
    parser_today.add_argument("--date", help="Specify date (YYYY-MM-DD)")
    parser_today.add_argument("--lang", choices=["en", "zh"], help="Override display language (en/zh)")

    # week
    parser_week = subparsers.add_parser("week", help="Show past 7 days trend")
    parser_week.add_argument("--lang", choices=["en", "zh"], help="Override display language (en/zh)")

    # report
    parser_rep = subparsers.add_parser("report", help="Generate Markdown report for date")
    parser_rep.add_argument("--date", help="Specify date (YYYY-MM-DD)")
    parser_rep.add_argument("--out", help="Output file path")
    parser_rep.add_argument("--lang", choices=["en", "zh"], help="Report language (en/zh)")

    # export
    parser_exp = subparsers.add_parser("export", help="Export report to ~/Documents/TimeReports/")
    parser_exp.add_argument("--date", help="Specify date (YYYY-MM-DD)")
    parser_exp.add_argument("--lang", choices=["en", "zh"], help="Report language (en/zh)")

    # status
    parser_status = subparsers.add_parser("status", help="Show daemon status & active window")
    parser_status.add_argument("--lang", choices=["en", "zh"], help="Display language (en/zh)")

    # lang
    parser_lang = subparsers.add_parser("lang", help="Get or set display language (en/zh/auto)")
    parser_lang.add_argument("target", nargs="?", choices=["en", "zh", "auto"], help="Set language to 'en', 'zh', or 'auto'")

    # service
    parser_srv = subparsers.add_parser("service", help="Manage systemd user service")
    parser_srv.add_argument("action", choices=["install", "start", "stop", "restart", "status", "enable", "disable"])

    args = parser.parse_args()

    if args.subcommand == "daemon":
        daemon = Daemon()
        daemon.run()
    elif args.subcommand == "today":
        cmd_today(args)
    elif args.subcommand == "week":
        cmd_week(args)
    elif args.subcommand == "report":
        cmd_report(args)
    elif args.subcommand == "export":
        cmd_export(args)
    elif args.subcommand == "status":
        cmd_status(args)
    elif args.subcommand == "lang":
        cmd_lang(args)
    elif args.subcommand == "service":
        cmd_service(args)
    else:
        cmd_today(args)


if __name__ == "__main__":
    main()
