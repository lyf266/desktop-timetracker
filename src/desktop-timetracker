# --- Hardware Input Constants ---
EVENT_FORMAT = "qqHHi" if struct.calcsize("P") == 8 else "llHHi"
EVENT_SIZE = struct.calcsize(EVENT_FORMAT)
PX_TO_METERS = 0.0254 / 96.0  # Standard 96 DPI: 1 inch = 0.0254m = 96px => 1px ≈ 0.2646 mm


def px_to_meters(px):
    return px * PX_TO_METERS


def format_distance(distance_px, lang="en"):
    meters = px_to_meters(distance_px)
    if meters >= 1000:
        km = meters / 1000.0
        return f"{km:.2f} km"
    elif meters >= 1:
        return f"{meters:.1f} m"
    else:
        cm = meters * 100.0
        return f"{cm:.1f} cm"


