def ensure_dirs():
    for d in [CONFIG_DIR, DATA_DIR, BIN_DIR, REPORTS_DIR, SYSTEMD_USER_DIR]:
        d.mkdir(parents=True, exist_ok=True)


def load_rules():
    if not CONFIG_FILE.exists():
        ensure_dirs()
        with open(CONFIG_FILE, "w", encoding="utf-8") as f:
            json.dump(DEFAULT_RULES, f, ensure_ascii=False, indent=2)
        return DEFAULT_RULES
    try:
        with open(CONFIG_FILE, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return DEFAULT_RULES


class Database:
    def __init__(self, db_path=DB_FILE):
        self.db_path = db_path
        self._init_db()

    def get_conn(self):
        conn = sqlite3.connect(self.db_path)
        conn.row_factory = sqlite3.Row
        conn.execute("PRAGMA journal_mode=WAL;")
        conn.execute("PRAGMA synchronous=NORMAL;")
        return conn

    def _init_db(self):
        ensure_dirs()
        with self.get_conn() as conn:
            conn.execute("""
                CREATE TABLE IF NOT EXISTS window_activities (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    start_time TEXT NOT NULL,
                    end_time TEXT NOT NULL,
                    duration_seconds INTEGER NOT NULL,
                    app_id TEXT NOT NULL,
                    app_name TEXT NOT NULL,
                    window_title TEXT NOT NULL,
                    category TEXT NOT NULL,
                    is_locked INTEGER DEFAULT 0,
                    is_idle INTEGER DEFAULT 0
                );
            """)
            conn.execute("CREATE INDEX IF NOT EXISTS idx_activity_time ON window_activities(start_time, end_time);")
            conn.execute("CREATE INDEX IF NOT EXISTS idx_activity_category ON window_activities(category);")
            conn.execute("CREATE INDEX IF NOT EXISTS idx_activity_app ON window_activities(app_id);")

    def save_record(self, start_time, end_time, duration, app_id, app_name, window_title, category, is_locked, is_idle, record_id=None):
        if duration <= 0:
            return None
        with self.get_conn() as conn:
            if record_id:
                conn.execute("""
                    UPDATE window_activities
                    SET end_time = ?, duration_seconds = ?, is_idle = ?
                    WHERE id = ?
                """, (end_time, duration, is_idle, record_id))
                return record_id
            else:
                cur = conn.execute("""
                    INSERT INTO window_activities (
                        start_time, end_time, duration_seconds,
                        app_id, app_name, window_title, category,
                        is_locked, is_idle
                    ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
                """, (start_time, end_time, duration, app_id, app_name, window_title, category, is_locked, is_idle))
                return cur.lastrowid

    def query_day(self, target_date):
        """Query activities for a specific YYYY-MM-DD date."""
        with self.get_conn() as conn:
            cur = conn.execute("""
                SELECT * FROM window_activities
                WHERE date(start_time) = date(?)
                ORDER BY start_time ASC
            """, (target_date,))
            return [dict(r) for r in cur.fetchall()]

    def query_date_range(self, start_date, end_date):
        with self.get_conn() as conn:
            cur = conn.execute("""
                SELECT * FROM window_activities
                WHERE date(start_time) >= date(?) AND date(start_time) <= date(?)
                ORDER BY start_time ASC
            """, (start_date, end_date))
            return [dict(r) for r in cur.fetchall()]


class Classifier:
    def __init__(self, rules):
        self.rules = rules

    def classify(self, app_id, window_title, is_locked):
        if is_locked:
            return "锁屏/休眠", "🔒", "锁屏/休眠"

        app_id_clean = (app_id or "").lower().strip()
        title_clean = window_title or ""

        friendly_name = APP_NAME_MAP.get(app_id_clean)
        if not friendly_name:
            if app_id_clean:
                friendly_name = app_id_clean.replace("-", " ").title()
            else:
                friendly_name = "未知应用"

        for cat in self.rules.get("categories", []):
            cat_name = cat.get("name", "其他")
            icon = cat.get("icon", "📌")

            # Check app match
            for a in cat.get("apps", []):
                if a and a.lower() in app_id_clean:
                    return cat_name, icon, friendly_name

            # Check title keywords
            for kw in cat.get("title_keywords", []):
                if kw and kw.lower() in title_clean.lower():
                    return cat_name, icon, friendly_name

        default_cat = self.rules.get("default_category", "其他应用")
        return default_cat, "📌", friendly_name


def format_duration(seconds):
    if seconds < 0:
        seconds = 0
    h = seconds // 3600
    m = (seconds % 3600) // 60
    s = seconds % 60
    if h > 0:
        return f"{h}小时{m:02d}分"
    elif m > 0:
        return f"{m}分钟{s:02d}秒"
    else:
        return f"{s}秒"


def format_duration_short(seconds):
    h = seconds // 3600
    m = (seconds % 3600) // 60
    if h > 0:
        return f"{h}h {m:02d}m"
    elif m > 0:
        return f"{m}m"
    else:
        return f"{seconds}s"


def make_bar(ratio, width=20):
    full_blocks = int(ratio * width)
    remainder = (ratio * width) - full_blocks
    chars = ["", "▏", "▎", "▍", "▌", "▋", "▊", "▉"]
    sub_char = chars[int(remainder * 8)] if remainder > 0 else ""
    bar = "█" * full_blocks + sub_char
    return bar.ljust(width, "░")


class ReportGenerator:
    @staticmethod
    def generate_markdown(records, target_date):
        if not records:
            return f"# 桌面使用时间日报 ({target_date})\n\n该日期无活动记录。\n"

        total_active_secs = 0
        total_locked_secs = 0
        cat_times = {}
        app_times = {}
        window_times = {}
        hourly_active = {h: 0 for h in range(24)}

        for r in records:
            dur = r["duration_seconds"]
            is_locked = r["is_locked"]
            cat = r["category"]
            app = r["app_name"]
            title = r["window_title"].strip() or "无标题窗口"

            if is_locked:
                total_locked_secs += dur
            else:
                total_active_secs += dur
                cat_times[cat] = cat_times.get(cat, 0) + dur
                app_times[app] = app_times.get(app, 0) + dur
                window_times[(app, title)] = window_times.get((app, title), 0) + dur

                try:
                    start_dt = datetime.datetime.fromisoformat(r["start_time"])
                    hourly_active[start_dt.hour] += dur
                except Exception:
                    pass

        grand_total = total_active_secs + total_locked_secs

        # Top Categories
        sorted_cats = sorted(cat_times.items(), key=lambda x: x[1], reverse=True)
        sorted_apps = sorted(app_times.items(), key=lambda x: x[1], reverse=True)[:10]
        sorted_windows = sorted(window_times.items(), key=lambda x: x[1], reverse=True)[:10]

        md = []
        md.append(f"# 📊 桌面使用时间日报 ({target_date})")
        md.append(f"\n> 自动生成时间: {datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\n")

        # Summary KPIs
        md.append("## 1. 核心概览\n")
        md.append(f"- **总开机时长**: `{format_duration(grand_total)}`")
        md.append(f"- **有效专注时长**: `{format_duration(total_active_secs)}` ({((total_active_secs/grand_total*100) if grand_total else 0):.1f}%)")
        md.append(f"- **锁屏/离开时长**: `{format_duration(total_locked_secs)}` ({((total_locked_secs/grand_total*100) if grand_total else 0):.1f}%)")

        # Category Breakdown Table
        md.append("\n## 2. 类别时间分布\n")
        md.append("| 分类 | 累计时长 | 占比 | 进度条 |")
        md.append("| :--- | :--- | :--- | :--- |")
        for cat, secs in sorted_cats:
            ratio = (secs / total_active_secs) if total_active_secs > 0 else 0
            bar = make_bar(ratio, width=15)
            md.append(f"| **{cat}** | `{format_duration(secs)}` | `{ratio*100:.1f}%` | `{bar}` |")

        # Top Apps Table
        md.append("\n## 3. 最常使用的应用 Top 10\n")
        md.append("| 排名 | 应用程序 | 累计时长 | 占有效时间比 |")
        md.append("| :---: | :--- | :--- | :--- |")
        for idx, (app, secs) in enumerate(sorted_apps, 1):
            ratio = (secs / total_active_secs) if total_active_secs > 0 else 0
            md.append(f"| {idx} | **{app}** | `{format_duration(secs)}` | `{ratio*100:.1f}%` |")

        # Top Window Captions Table
        md.append("\n## 4. 关键窗口与任务详情 Top 10\n")
        md.append("| 排名 | 对应应用 | 窗口标题明细 | 持续时间 |")
        md.append("| :---: | :--- | :--- | :--- |")
        for idx, ((app, title), secs) in enumerate(sorted_windows, 1):
            clean_title = title.replace("|", "-")
            if len(clean_title) > 60:
                clean_title = clean_title[:57] + "..."
            md.append(f"| {idx} | {app} | `{clean_title}` | `{format_duration(secs)}` |")

        # Hourly Activity Chart
        md.append("\n## 5. 全天活跃时段分布 (小时)\n")
        md.append("| 时段 | 活跃时间 | 活跃度可视化 |")
        md.append("| :---: | :--- | :--- |")
        for h in range(24):
            secs = hourly_active[h]
            if secs > 0:
                ratio = min(secs / 3600.0, 1.0)
                bar = make_bar(ratio, width=12)
                md.append(f"| `{h:02d}:00 - {h+1:02d}:00` | `{format_duration_short(secs)}` | `{bar}` |")

        md.append("\n---\n*由 Desktop TimeTracker 自动记录生成*\n")
        return "\n".join(md)


class Daemon:
    def __init__(self):
        self.rules = load_rules()
        self.classifier = Classifier(self.rules)
        self.db = Database()
        self.running = True
        self.current_chunk = None  # dict representing active continuous chunk
        self.last_flush_time = time.time()
        self.kwin_script_id = None
        self.journal_proc = None

    def get_lock_status(self):
        try:
            res = subprocess.run(
                ["qdbus6", "org.freedesktop.ScreenSaver", "/ScreenSaver", "org.freedesktop.ScreenSaver.GetActive"],
                capture_output=True, text=True, timeout=1.5
            )
            return res.stdout.strip() == "true"
        except Exception:
            return False

    def load_kwin_script(self):
        # Unload existing first
        subprocess.run(["qdbus6", "org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting.unloadScript", "timetracker_kwin"], capture_output=True)
        res = subprocess.run(
            ["qdbus6", "org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting.loadScript", str(KWIN_SCRIPT_FILE), "timetracker_kwin"],
            capture_output=True, text=True
        )
        script_id = res.stdout.strip()
        if script_id and script_id.isdigit() and int(script_id) >= 0:
            self.kwin_script_id = int(script_id)
            subprocess.run(["qdbus6", "org.kde.KWin", f"/Scripting/Script{self.kwin_script_id}", "org.kde.kwin.Script.run"], capture_output=True)
            print(f"[{datetime.datetime.now()}] KWin script registered successfully (id={self.kwin_script_id})")
            return True
        else:
            print(f"[{datetime.datetime.now()}] Warning: failed to load KWin script: {res.stderr or res.stdout}")
            return False

    def unload_kwin_script(self):
        try:
            subprocess.run(["qdbus6", "org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting.unloadScript", "timetracker_kwin"], capture_output=True)
        except Exception:
            pass

    def flush_chunk(self, final=False):
        if not self.current_chunk:
            return

        c = self.current_chunk
        now = datetime.datetime.now()
        start_dt = c["start_dt"]
        last_dt = c["last_dt"]
        duration = max(1, int((last_dt - start_dt).total_seconds()))

        # Soft idle detection: if active on same window > threshold
        soft_threshold = self.rules.get("soft_idle_threshold_seconds", 900)
        is_idle = 1 if (duration > soft_threshold and not c["is_locked"]) else 0

        rec_id = self.db.save_record(
            start_time=start_dt.strftime("%Y-%m-%d %H:%M:%S"),
            end_time=last_dt.strftime("%Y-%m-%d %H:%M:%S"),
            duration=duration,
            app_id=c["app_id"],
            app_name=c["app_name"],
            window_title=c["window_title"],
            category=c["category"],
            is_locked=c["is_locked"],
            is_idle=is_idle,
            record_id=c.get("db_id")
        )
        c["db_id"] = rec_id
        self.last_flush_time = time.time()

        if final:
            self.current_chunk = None

    def check_daily_rollover(self, current_date_str):
        if self.current_chunk:
            chunk_date = self.current_chunk["start_dt"].strftime("%Y-%m-%d")
            if chunk_date != current_date_str:
                print(f"[{datetime.datetime.now()}] Date rollover detected ({chunk_date} -> {current_date_str}). Exporting report.")
                self.flush_chunk(final=True)
                # Export yesterday's report
                self.export_report(chunk_date)

    def export_report(self, date_str):
        try:
            records = self.db.query_day(date_str)
            if records:
                content = ReportGenerator.generate_markdown(records, date_str)
                out_file = REPORTS_DIR / f"{date_str}.md"
                with open(out_file, "w", encoding="utf-8") as f:
                    f.write(content)
                print(f"[{datetime.datetime.now()}] Daily report exported to {out_file}")
        except Exception as e:
            print(f"[{datetime.datetime.now()}] Error exporting report for {date_str}: {e}")

    def handle_sample(self, window_data):
        now = datetime.datetime.now()
        today_str = now.strftime("%Y-%m-%d")
        self.check_daily_rollover(today_str)

        is_locked = self.get_lock_status()
        if is_locked:
            app_id = "screensaver"
            window_title = "屏幕已锁定"
        elif not window_data:
            app_id = "plasmashell"
            window_title = "KDE 桌面空白处"
        else:
            app_id = window_data.get("desktopFile") or window_data.get("resourceClass") or window_data.get("resourceName") or "unknown"
            window_title = window_data.get("caption") or ""

        category, icon, app_name = self.classifier.classify(app_id, window_title, is_locked)

        # Match against current chunk
        if self.current_chunk:
            c = self.current_chunk
            same_app = (c["app_id"] == app_id)
            same_title = (c["window_title"] == window_title)
            same_lock = (c["is_locked"] == (1 if is_locked else 0))

            if same_app and same_title and same_lock:
                c["last_dt"] = now
                # Periodic flush every 10 seconds for fresh real-time data
                if time.time() - self.last_flush_time >= 10:
                    self.flush_chunk(final=False)
                return

        # State changed or first chunk
        self.flush_chunk(final=True)

        self.current_chunk = {
            "start_dt": now,
            "last_dt": now,
            "app_id": app_id,
            "app_name": app_name,
            "window_title": window_title,
            "category": category,
            "is_locked": 1 if is_locked else 0,
            "db_id": None
        }
        self.flush_chunk(final=False)

    def run(self):
        print(f"[{datetime.datetime.now()}] Starting Desktop TimeTracker Daemon...")
        ensure_dirs()
        self.load_kwin_script()

        def sig_handler(sig, frame):
            print(f"\n[{datetime.datetime.now()}] Received shutdown signal ({sig}). Cleaning up...")
            self.running = False

        signal.signal(signal.SIGINT, sig_handler)
        signal.signal(signal.SIGTERM, sig_handler)

        cmd = ["journalctl", "--user", "-u", "plasma-kwin_wayland", "-f", "-o", "cat", "--lines", "0"]
        self.journal_proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, bufsize=1)

        last_heartbeat = time.time()

        try:
            while self.running:
                line = self.journal_proc.stdout.readline()
                if not line:
                    time.sleep(0.5)
                    continue

                if "TIMETRACKER_TICK:" in line:
                    raw_data = line.split("TIMETRACKER_TICK:", 1)[1].strip()
                    try:
                        if raw_data == "null":
                            data = None
                        else:
                            data = json.loads(raw_data)
                        self.handle_sample(data)
                    except Exception as e:
                        pass

                # Every 60 seconds check health
                if time.time() - last_heartbeat > 60:
                    last_heartbeat = time.time()
                    # Export today's live report draft
                    today_str = datetime.datetime.now().strftime("%Y-%m-%d")
                    self.export_report(today_str)

        finally:
            print(f"[{datetime.datetime.now()}] Finalizing database and unloading script...")
            self.flush_chunk(final=True)
            if self.journal_proc:
                self.journal_proc.terminate()
            self.unload_kwin_script()
            print(f"[{datetime.datetime.now()}] TimeTracker Daemon stopped cleanly.")


