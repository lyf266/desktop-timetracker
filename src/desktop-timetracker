def cmd_today(args):
    db = Database()
    target_date = args.date or datetime.datetime.now().strftime("%Y-%m-%d")
    records = db.query_day(target_date)

    if not records:
        print(f"\n📅 【{target_date}】今日暂无记录。请确保后台服务已启动 (`timetrack service start`)。\n")
        return

    total_active = sum(r["duration_seconds"] for r in records if not r["is_locked"])
    total_locked = sum(r["duration_seconds"] for r in records if r["is_locked"])
    grand_total = total_active + total_locked

    cat_times = {}
    app_times = {}
    win_times = {}

    rules = load_rules()
    icon_map = {c["name"]: c.get("icon", "📌") for c in rules.get("categories", [])}
    icon_map["锁屏/休眠"] = "🔒"

    for r in records:
        dur = r["duration_seconds"]
        if not r["is_locked"]:
            cat = r["category"]
            app = r["app_name"]
            title = r["window_title"] or "桌面"
            cat_times[cat] = cat_times.get(cat, 0) + dur
            app_times[app] = app_times.get(app, 0) + dur
            win_times[(app, title)] = win_times.get((app, title), 0) + dur

    print(f"\n╔═══════════════════════════════════════════════════════════════╗")
    print(f"║          📊 桌面时间使用简报 ({target_date})             ║")
    print(f"╚═══════════════════════════════════════════════════════════════╝")
    print(f"  ⚡ 专注活跃时长: \033[1;32m{format_duration(total_active)}\033[0m ({((total_active/grand_total*100) if grand_total else 0):.1f}%)")
    print(f"  🔒 锁屏挂机时长: \033[1;33m{format_duration(total_locked)}\033[0m ({((total_locked/grand_total*100) if grand_total else 0):.1f}%)")
    print(f"  ⏳ 累计在线时间: {format_duration(grand_total)}")
    print(f"─────────────────────────────────────────────────────────────────")

    print(f"\n📂 【类别分布】:")
    for cat, secs in sorted(cat_times.items(), key=lambda x: x[1], reverse=True):
        ratio = secs / total_active if total_active else 0
        icon = icon_map.get(cat, "📌")
        bar = make_bar(ratio, width=16)
        pct_str = f"{ratio*100:5.1f}%"
        dur_str = format_duration_short(secs).rjust(8)
        print(f"  {icon} {cat.ljust(6)} [{bar}] \033[1;36m{pct_str}\033[0m ({dur_str})")

    print(f"\n🏆 【Top 应用排行】:")
    for idx, (app, secs) in enumerate(sorted(app_times.items(), key=lambda x: x[1], reverse=True)[:7], 1):
        ratio = secs / total_active if total_active else 0
        print(f"  {idx}. \033[1m{app}\033[0m: {format_duration(secs)} ({ratio*100:.1f}%)")

    print(f"\n🔍 【关键任务详情】:")
    for idx, ((app, title), secs) in enumerate(sorted(win_times.items(), key=lambda x: x[1], reverse=True)[:5], 1):
        clean_title = title if len(title) <= 45 else title[:42] + "..."
        print(f"  {idx}. [{app}] {clean_title} ({format_duration(secs)})")
    print("")


def cmd_week(args):
    db = Database()
    today = datetime.date.today()
    start = today - datetime.timedelta(days=6)
    records = db.query_date_range(start.strftime("%Y-%m-%d"), today.strftime("%Y-%m-%d"))

    if not records:
        print(f"\n最近 7 天暂无时间数据。\n")
        return

    day_totals = {}
    day_active = {}
    for i in range(7):
        d_str = (start + datetime.timedelta(days=i)).strftime("%Y-%m-%d")
        day_totals[d_str] = 0
        day_active[d_str] = 0

    for r in records:
        d = r["start_time"][:10]
        dur = r["duration_seconds"]
        if d in day_totals:
            day_totals[d] += dur
            if not r["is_locked"]:
                day_active[d] += dur

    max_active = max(day_active.values()) if day_active else 1

    print(f"\n╔═══════════════════════════════════════════════════════════════╗")
    print(f"║             📈 最近 7 天活跃趋势统计                         ║")
    print(f"╚═══════════════════════════════════════════════════════════════╝")
    for d, secs in day_active.items():
        ratio = secs / max_active if max_active else 0
        bar = make_bar(ratio, width=15)
        print(f"  {d}: [{bar}] \033[1;32m{format_duration_short(secs).rjust(7)}\033[0m (总计 {format_duration_short(day_totals[d])})")
    print("")


def cmd_report(args):
    db = Database()
    target_date = args.date or datetime.datetime.now().strftime("%Y-%m-%d")
    records = db.query_day(target_date)
    md_content = ReportGenerator.generate_markdown(records, target_date)

