def cmd_today(args):
    lang = get_language(args.lang)
    t = I18N[lang]
    db = Database()
    target_date = args.date or datetime.datetime.now().strftime("%Y-%m-%d")
    records = db.query_day(target_date)

    if not records:
        print(f"\n📅 {t['no_records_today'].format(date=target_date)}\n")
        return

    total_active = sum(r["duration_seconds"] for r in records if not r["is_locked"])
    total_locked = sum(r["duration_seconds"] for r in records if r["is_locked"])
    grand_total = total_active + total_locked

    total_keys = sum((r.get("key_presses") or 0) for r in records if not r["is_locked"])
    total_clicks = sum((r.get("mouse_clicks") or 0) for r in records if not r["is_locked"])
    total_mouse_px = sum((r.get("mouse_distance_px") or 0) for r in records if not r["is_locked"])

    active_mins = total_active / 60.0
    kpm = (total_keys / active_mins) if active_mins > 0 else 0.0

    cat_times = {}
    cat_icons = {}
    app_times = {}
    win_times = {}
    hourly_active = {h: 0 for h in range(24)}
    hourly_keys = {h: 0 for h in range(24)}
    hourly_mouse = {h: 0 for h in range(24)}

    for r in records:
        dur = r["duration_seconds"]
        if not r["is_locked"]:
            cat_raw = r["category"]
            cat_display, icon = get_category_display(cat_raw, lang)
            cat_times[cat_display] = cat_times.get(cat_display, 0) + dur
            cat_icons[cat_display] = icon

            app = r["app_name"]
            title = r["window_title"] or "Desktop"
            app_times[app] = app_times.get(app, 0) + dur
            win_times[(app, title)] = win_times.get((app, title), 0) + dur

            kp = r.get("key_presses") or 0
            mdist = r.get("mouse_distance_px") or 0
            try:
                start_dt = datetime.datetime.fromisoformat(r["start_time"])
                h = start_dt.hour
                hourly_active[h] += dur
                hourly_keys[h] += kp
                hourly_mouse[h] += mdist
            except Exception:
                pass

    title_box = f"📊 {t['title_today'].format(date=target_date)}"
    box_len = max(63, len(title_box) + 12)
    border = "═" * box_len

    print(f"\n╔{border}╗")
    print(f"║ {title_box.center(box_len - 2)} ║")
    print(f"╚{border}╝")
    pct_active = (total_active / grand_total * 100) if grand_total else 0
    pct_locked = (total_locked / grand_total * 100) if grand_total else 0
    print(f"  ⚡ {t['active_time']}: \033[1;32m{format_duration(total_active, lang)}\033[0m ({pct_active:.1f}%)")
    print(f"  🔒 {t['locked_time']}: \033[1;33m{format_duration(total_locked, lang)}\033[0m ({pct_locked:.1f}%)")
    print(f"  ⏳ {t['total_time']}: {format_duration(grand_total, lang)}")
    print(f"  ⌨️  {t['total_keys']}: \033[1;36m{total_keys:,}\033[0m {t['unit_times']} (\033[36m{kpm:.1f} {t['kpm_unit']}\033[0m)")
    print(f"  🖱️  {t['total_mouse']}: \033[1;35m{format_distance(total_mouse_px, lang)}\033[0m ({t['mouse_clicks_label']}: {total_clicks:,})")
    print(f"─────────────────────────────────────────────────────────────────")

    print(f"\n📂 【{t['category_dist']}】:")
    for cat, secs in sorted(cat_times.items(), key=lambda x: x[1], reverse=True):
        ratio = secs / total_active if total_active else 0
        icon = cat_icons.get(cat, "📌")
        bar = make_bar(ratio, width=16)
        pct_str = f"{ratio*100:5.1f}%"
        dur_str = format_duration_short(secs).rjust(8)
        print(f"  {icon} {cat.ljust(14 if lang=='en' else 6)} [{bar}] \033[1;36m{pct_str}\033[0m ({dur_str})")

    print(f"\n🏆 【{t['top_apps']}】:")
    for idx, (app, secs) in enumerate(sorted(app_times.items(), key=lambda x: x[1], reverse=True)[:7], 1):
        ratio = secs / total_active if total_active else 0
        print(f"  {idx}. \033[1m{app}\033[0m: {format_duration(secs, lang)} ({ratio*100:.1f}%)")

    print(f"\n🔍 【{t['key_tasks']}】:")
    for idx, ((app, title), secs) in enumerate(sorted(win_times.items(), key=lambda x: x[1], reverse=True)[:5], 1):
        clean_title = title if len(title) <= 45 else title[:42] + "..."
        print(f"  {idx}. [{app}] {clean_title} ({format_duration(secs, lang)})")

    # 24-Hour Integrated Matrix
    active_hours = [h for h in range(24) if hourly_active[h] > 0 or hourly_keys[h] > 0 or hourly_mouse[h] > 0]
    if active_hours:
        print(f"\n🕒 【{t['hourly_dist']}】:")
        print(f"  {t['col_period'].ljust(13)} {t['col_focus'].rjust(8)}   {t['col_keys'].rjust(10)}   {t['col_mouse'].rjust(10)}   {t['col_intensity']}")
        print(f"  {'─'*13} {'─'*8}   {'─'*10}   {'─'*10}   {'─'*17}")
        for h in range(24):
            secs = hourly_active[h]
            keys = hourly_keys[h]
            m_px = hourly_mouse[h]
            if secs > 0 or keys > 0 or m_px > 0:
                ratio = min(secs / 3600.0, 1.0)
                bar = make_bar(ratio, width=15)
                period_str = f"{h:02d}:00 - {h+1:02d}:00"
                dur_str = format_duration_short(secs).rjust(8)
                keys_str = f"{keys:,} {t['unit_short']}".rjust(10)
                dist_str = format_distance(m_px, lang).rjust(10)
                print(f"  {period_str} {dur_str}   \033[1;36m{keys_str}\033[0m   \033[1;35m{dist_str}\033[0m   [{bar}]")
    print("")


def cmd_week(args):
    lang = get_language(args.lang)
    t = I18N[lang]
    db = Database()
    today = datetime.date.today()
    start = today - datetime.timedelta(days=6)
    records = db.query_date_range(start.strftime("%Y-%m-%d"), today.strftime("%Y-%m-%d"))

    if not records:
        print(f"\n{t['no_records_week']}\n")
        return

    day_totals = {}
    day_active = {}
    for i in range(7):
        d_str = (start + datetime.timedelta(days=i)).strftime("%Y-%m-%d")
        day_totals[d_str] = 0
        day_active[d_str] = 0

    for r in records:
        d = r["start_time"][:10]
        dur = r["duration_seconds"]
        if d in day_totals:
            day_totals[d] += dur
            if not r["is_locked"]:
                day_active[d] += dur

    max_active = max(day_active.values()) if day_active else 1

    print(f"\n╔═══════════════════════════════════════════════════════════════╗")
    print(f"║             📈 {t['week_title'].center(46)} ║")
    print(f"╚═══════════════════════════════════════════════════════════════╝")
    for d, secs in day_active.items():
        ratio = secs / max_active if max_active else 0
        bar = make_bar(ratio, width=15)
        print(f"  {d}: [{bar}] \033[1;32m{format_duration_short(secs).rjust(7)}\033[0m (Total {format_duration_short(day_totals[d])})")
    print("")


