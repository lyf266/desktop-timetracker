def ensure_dirs():
    for d in [CONFIG_DIR, DATA_DIR, BIN_DIR, REPORTS_DIR, SYSTEMD_USER_DIR]:
        d.mkdir(parents=True, exist_ok=True)


def load_rules():
    if not CONFIG_FILE.exists():
        ensure_dirs()
        with open(CONFIG_FILE, "w", encoding="utf-8") as f:
            json.dump(DEFAULT_RULES, f, ensure_ascii=False, indent=2)
        return DEFAULT_RULES
    try:
        with open(CONFIG_FILE, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return DEFAULT_RULES


def save_rules(rules):
    ensure_dirs()
    with open(CONFIG_FILE, "w", encoding="utf-8") as f:
        json.dump(rules, f, ensure_ascii=False, indent=2)


def get_language(cli_lang=None):
    if cli_lang in ["en", "zh"]:
        return cli_lang
    rules = load_rules()
    cfg_lang = rules.get("language", "auto")
    if cfg_lang in ["en", "zh"]:
        return cfg_lang
    sys_locale = (os.environ.get("LC_ALL") or os.environ.get("LANG") or os.environ.get("LANGUAGE") or "").lower()
    if sys_locale.startswith("zh") or "chinese" in sys_locale or "cn" in sys_locale:
        return "zh"
    return "en"


def get_category_display(cat_raw, lang="en"):
    cat_key = CATEGORY_NAME_TO_KEY.get(cat_raw)
