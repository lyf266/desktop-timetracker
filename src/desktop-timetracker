def cmd_status(args):
    res = subprocess.run(["systemctl", "--user", "is-active", "desktop-timetracker.service"], capture_output=True, text=True)
    state = res.stdout.strip()
    color = "\033[1;32m" if state == "active" else "\033[1;31m"
    print(f"\n服务运行状态: {color}{state.upper()}\033[0m")

    # Check latest record
    db = Database()
    with db.get_conn() as conn:
        cur = conn.execute("SELECT * FROM window_activities ORDER BY id DESC LIMIT 1;")
        row = cur.fetchone()
        if row:
            print(f"最近捕获时间: {row['end_time']}")
            print(f"当前应用名称: {row['app_name']} ({row['category']})")
            print(f"当前窗口标题: {row['window_title']}")
            print(f"当前连续时长: {format_duration(row['duration_seconds'])}\n")
        else:
            print("数据库中暂无记录。\n")


def cmd_service(args):
    action = args.action
    if action == "install":
        SYSTEMD_USER_DIR.mkdir(parents=True, exist_ok=True)
        service_content = f"""[Unit]
Description=KDE Wayland Desktop Time Tracker Daemon
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart={BIN_DIR}/desktop-timetracker daemon
Restart=always
RestartSec=5s
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target
"""
        with open(SERVICE_FILE, "w", encoding="utf-8") as f:
            f.write(service_content)
        subprocess.run(["systemctl", "--user", "daemon-reload"])
        subprocess.run(["systemctl", "--user", "enable", "--now", "desktop-timetracker.service"])
        print(f"✅ 已成功安装并启动 systemd 用户服务: desktop-timetracker.service")
    elif action in ["start", "stop", "restart", "status", "enable", "disable"]:
        subprocess.run(["systemctl", "--user", action, "desktop-timetracker.service"])


def main():
    parser = argparse.ArgumentParser(
        prog="desktop-timetracker",
        description="KDE Plasma 6 Wayland 桌面时间记录与分析系统"
    )
    subparsers = parser.add_subparsers(dest="subcommand", help="子命令")

    # daemon
    subparsers.add_parser("daemon", help="启动后台守护采集进程")

    # today
    parser_today = subparsers.add_parser("today", help="查看今日时间统计看板")
    parser_today.add_argument("--date", help="指定日期 (YYYY-MM-DD)")

    # week
    subparsers.add_parser("week", help="查看最近 7 天时间趋势")

    # report
    parser_rep = subparsers.add_parser("report", help="生成指定日期的 Markdown 报告")
    parser_rep.add_argument("--date", help="指定日期 (YYYY-MM-DD)")
    parser_rep.add_argument("--out", help="输出文件路径")

    # export
    parser_exp = subparsers.add_parser("export", help="导出今日报告至 ~/Documents/TimeReports/")
    parser_exp.add_argument("--date", help="指定日期 (YYYY-MM-DD)")

    # status
    subparsers.add_parser("status", help="查看采集服务与当前活动状态")

    # service
    parser_srv = subparsers.add_parser("service", help="管理 systemd 用户服务")
    parser_srv.add_argument("action", choices=["install", "start", "stop", "restart", "status", "enable", "disable"])

    args = parser.parse_args()

    if args.subcommand == "daemon":
        daemon = Daemon()
        daemon.run()
    elif args.subcommand == "today":
        cmd_today(args)
    elif args.subcommand == "week":
        cmd_week(args)
    elif args.subcommand == "report":
        cmd_report(args)
    elif args.subcommand == "export":
        cmd_export(args)
    elif args.subcommand == "status":
        cmd_status(args)
    elif args.subcommand == "service":
        cmd_service(args)
    else:
        # Default to today
        cmd_today(args)


if __name__ == "__main__":
    main()
