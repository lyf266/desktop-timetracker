[Unit]
Description=KDE Wayland Desktop Time Tracker Daemon
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/desktop-timetracker daemon
Restart=always
RestartSec=5s
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target
